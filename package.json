{
  "name": "assistpro",
  "version": "1.0.0",
  "description": "Professional services website built with React, TypeScript, and Express",
  "type": "module",
  "license": "MIT",
  "author": "AssistPro Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/revaza88/assistpro.git"
  },
  "keywords": [
    "react",
    "typescript",
    "express",
    "tailwindcss",
    "professional-services",
    "cloudpanel"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --import tsx server/dev.ts",
    "build": "vite build && node --import tsx scripts/prerender.ts && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/release-manifest.mjs",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "clean": "powershell -Command \"Get-ChildItem -Path ./ -Recurse -Include '*-new.*', '*-backup.*', '*-old.*', '*.bak' | Remove-Item -Force\"",
    "deploy": "bash deploy.sh production",
    "deploy:staging": "bash deploy.sh staging",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop assistpro",
    "pm2:restart": "pm2 restart assistpro",
    "pm2:logs": "pm2 logs assistpro",
    "health": "curl -f http://localhost:3000/health || curl -f http://localhost:5000/health",
    "test": "node --import tsx --test server/storage.test.ts server/inquiry.test.ts server/pricing.test.ts server/seo.test.ts server/http.test.ts scripts/browser-policy.test.ts scripts/client-bundle.test.ts scripts/brand-assets.test.ts scripts/release.test.mjs",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@types/react-router-dom": "^5.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
