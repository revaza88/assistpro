# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
INTAKE_MODE=local
TRUST_PROXY=false
LOG_TO_FILE=false

# SEO: set only after confirming the public origin. Local/test defaults are noindex.
# SITE_URL=https://your-confirmed-domain.example
INDEXING_ENABLED=false

# Persistent submissions file; set this in the server's process environment.
# DATA_FILE=/persistent/assistpro/submissions.json

# Database Configuration (PostgreSQL) - Optional
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Security
CORS_ORIGIN=http://localhost:5000

# Features
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_MONITORING=true

# Logging
LOG_LEVEL=info

# Production Configuration (uncomment for production)
# NODE_ENV=production
# PORT=3000
# CORS_ORIGIN=https://your-domain.com
