NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Set to the chosen HTTPS origin before launch; no domain is assumed.
SITE_URL=https://your-confirmed-domain.example
CORS_ORIGIN=https://your-confirmed-domain.example
# Keep false through staging and verification. Enable only at public launch.
INDEXING_ENABLED=false
# Public informational site only; no database or real intake is provisioned.
INTAKE_MODE=disabled
# One same-host Nginx proxy for PM2. Compose overrides this to one controlled hop.
TRUST_PROXY=loopback
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_MONITORING=true
LOG_LEVEL=info
LOG_TO_FILE=false
# Only for explicit local test mode. Use one process and persistent private storage.
DATA_FILE=/var/lib/assistpro/submissions.json
